{
    "python.envFile": "${workspaceFolder}/scripts/.env",
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": false,
    "python.autoComplete.extraPaths": [
        "/home/deeplearning/.pyenv/versions/3.10.0/lib/python3.10/site-packages",
    ],
    "cursorpyright.analysis.extraPaths": [
        "/home/deeplearning/.pyenv/versions/3.10.0/lib/python3.10/site-packages",
    ],
    // https://forum.cursor.com/t/the-mdc-editor-is-whack-please-revert-it-or-just-generate-a-template/50906/5
    "workbench.editorAssociations": {
        "*.mdc": "default"
    },
    "files.associations": {
        "*.mdc": "markdown",
        "*yml.tpl": "yaml",
    },
    "yaml.validate": false, // Did this to shutup noise from Ansible .yml.tpl 
    // Added this to stop project Ruff from fighting system ruff
    "ruff.configuration": "/home/deeplearning/.config/precommit/ruff.toml",
    "ruff.configurationPreference": "editorOnly", // ignore the repo's ruff.toml; use only the file above
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    }
}
